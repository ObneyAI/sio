{:paths ["src"]

 ;; sio is provider-agnostic: it renders prompts and parses responses.
 ;; It never calls an LLM, so it depends only on Malli (typing/validation)
 ;; and data.json (JSON parsing for complex output fields).
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        metosin/malli {:mvn/version "0.16.4"}}

 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.0"}
                     cheshire/cheshire {:mvn/version "5.13.0"}}}

  ;; cheshire is test-only: the guide tests build complex input values as JSON
  ;; text exactly as a caller that serializes them with cheshire does.
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      cheshire/cheshire {:mvn/version "5.13.0"}}
         :main-opts ["-m" "kaocha.runner"]}

  :nrepl {:extra-paths ["test"]
          :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                       cheshire/cheshire {:mvn/version "5.13.0"}}
          :jvm-opts ["-Djdk.attach.allowAttachSelf"]
          :main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}

  :kondo {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.03.13"}}
          :main-opts ["-m" "clj-kondo.main"]}}}
